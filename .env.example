# Comma-separated tokens (comma-separated list)
# Optional static admin tokens; client tokens are created with the CLI
POURGATE_TOKENS=pg-change-me
# Provider keys (comma-separated to rotate multiple keys of the SAME account/provider policy)
GROQ_API_KEYS=
GEMINI_API_KEYS=
CEREBRAS_API_KEYS=
MISTRAL_API_KEYS=
OPENROUTER_API_KEYS=
# Dashboard login (leave empty to disable the dashboard/admin API). Use a long random password.
POURGATE_ADMIN_PASSWORD=
# Set to true when served over HTTPS so the session cookie is marked Secure
# POURGATE_COOKIE_SECURE=true
# Optional: directory with the built dashboard (default ./public)
# POURGATE_STATIC_DIR=./public
# Optional: SQLite path for client tokens and usage
# POURGATE_DB=./data/pourgate.db
PORT=3000
# Optional: override registry directory
# POURGATE_REGISTRY_DIR=./registry
