# Comma-separated tokens (comma-separated list)
# Optional static admin tokens; client tokens are created with the CLI
POURGATE_TOKENS=pg-change-me
# Provider keys (comma-separated to rotate multiple keys of the SAME account/provider policy)
GROQ_API_KEYS=
GEMINI_API_KEYS=
CEREBRAS_API_KEYS=
MISTRAL_API_KEYS=
OPENROUTER_API_KEYS=
# Dashboard login (leave empty to disable the dashboard/admin API). Use a long random password.
POURGATE_ADMIN_PASSWORD=
# Set to true when served over HTTPS so the session cookie is marked Secure
# POURGATE_COOKIE_SECURE=true
# Optional: directory with the built dashboard (default ./public)
# POURGATE_STATIC_DIR=./public
# Optional: master key for provider keys stored via the dashboard (openssl rand -hex 32).
# If unset, data/master.key is generated on first start.
# POURGATE_MASTER_KEY=
# Optional: sync the model registry from a published bundle (see README, "Registry sync")
# POURGATE_REGISTRY_URL=https://example.com/registry.json
# Ed25519 public key (PEM or path to a PEM file). When set, bundles MUST be signed.
# POURGATE_REGISTRY_PUBKEY=./registry-public.pem
# POURGATE_REGISTRY_SYNC_HOURS=12
# Optional: directory of local provider YAML files that override/extend the registry
# POURGATE_OVERRIDES_DIR=./overrides
# Optional: SQLite path for client tokens and usage
# POURGATE_DB=./data/pourgate.db
PORT=3000
# Optional: override registry directory
# POURGATE_REGISTRY_DIR=./registry

# Optional: give up on a provider that does not start answering within this many ms, then fail over
# POURGATE_UPSTREAM_TIMEOUT_MS=60000
# Optional: consecutive failures before a model is skipped for a while (circuit breaker)
# POURGATE_BREAKER_THRESHOLD=5
# Optional: serve expired cache entries for this many seconds, only when every provider is failing
# POURGATE_CACHE_STALE_SECONDS=3600
# Optional: cap the cache size
# POURGATE_CACHE_MAX_MB=64
# Listen address. Default 127.0.0.1 (this machine only). 0.0.0.0 exposes the gateway to the network: add HTTPS + a firewall first.
# POURGATE_HOST=127.0.0.1

# Optional: re-check every provider in the background (minutes, minimum 15; costs a few free tokens per run)
# POURGATE_HEALTH_MINUTES=60
# Optional: URL that receives a JSON alert when a provider stops or resumes working (Slack/Discord webhooks work)
# POURGATE_ALERT_WEBHOOK=
# Optional: stop the dashboard from asking GitHub whether a newer release exists
# POURGATE_UPDATE_CHECK=off
