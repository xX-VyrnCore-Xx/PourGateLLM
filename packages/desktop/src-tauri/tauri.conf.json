{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PourGateLLM",
  "version": "0.1.1",
  "identifier": "dev.pourgatellm.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "server/": "server/"
    },
    "publisher": "PourGateLLM",
    "shortDescription": "Self-hosted gateway for free LLM tiers",
    "longDescription": "Unifies the free tiers of many LLM providers behind one OpenAI-compatible API, with failover, prompt-complexity routing, per-client tokens and a dashboard.",
    "category": "DeveloperTool",
    "copyright": "MIT License",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Italian"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
