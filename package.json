{
  "name": "pourgatellm",
  "private": true,
  "version": "0.1.1",
  "description": "Self-hosted gateway that unifies free LLM tiers behind one OpenAI-compatible API: smart failover, prompt-complexity routing, per-client tokens, encrypted keys and an open model registry.",
  "keywords": [
    "llm",
    "openai-compatible",
    "llm-gateway",
    "llm-router",
    "ai-gateway",
    "self-hosted",
    "typescript",
    "hono",
    "sqlite",
    "free-tier"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xX-VyrnCore-Xx/PourGateLLM.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "tsx watch packages/server/src/index.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "start": "node --no-warnings packages/server/dist/index.js",
    "cli": "tsx packages/server/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
